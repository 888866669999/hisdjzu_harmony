{
  "apiType": "stageMode",
  "buildOption": {
    // 这里原本有 `"externalNativeOptions": { "abiFilters": ["arm64-v8a"] }`，
    // 现已移除。
    //
    // 当时为什么必须限制：液态玻璃库 com.hm.appleui.hw 只提供 arm64-v8a 的
    // libliquidglass.so，若同时声明其它 ABI，安装到 x86_64 模拟器时会直接失败：
    //   code:9568347 install parse native so failed. ... the Abi type supported
    //   by the device does not match the Abi type configured in the C++ project.
    // 后果是应用**无法安装到 x86_64 模拟器**，只能在 arm64 真机上调试。
    //
    // 为什么现在可以删：该库已随「改用系统沉浸材质」整体移除
    // （oh-package.json5 里已无 com.hm.appleui.hw，也没有任何其它原生库），
    // 产物不再带 .so，四个 ABI 通用 —— 真机与模拟器装的是同一个 HAP。
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}